module Simple

intent:
    Simple calculator example

func add(a: int, b: int) -> int {
    return a + b
}

func subtract(a: int, b: int) -> int {
    return a - b
}

func multiply(a: int, b: int) -> int {
    return a * b
}

func divide(a: float, b: float) -> float {
    if b == 0.0 {
        return 0.0
    }
    return a / b
}

func is_even(n: int) -> bool {
    return n % 2 == 0
}

func main() -> int {
    let x = 10
    let y = 5
    
    let sum = add(x, y)
    let diff = subtract(x, y)
    let product = multiply(x, y)
    let quotient = divide(x.to_float(), y.to_float())
    
    let check = is_even(x)
    
    return 0
}
